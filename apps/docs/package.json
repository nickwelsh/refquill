{
    "name": "@refquill/docs",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "pnpm api:generate && docs-base dev",
        "build": "pnpm api:generate && node ../../scripts/clean-docs-build.mjs && docs-base build && node ../../scripts/prepare-docs-worker.mjs",
        "api:generate": "pnpm --workspace-root docs:rustdoc && refquill generate ../../refquill.json && node tooling/generate-references.mjs",
        "api:validate": "refquill validate generated/api.json",
        "start": "wrangler dev --config wrangler.jsonc --local",
        "types:check": "tsc --noEmit",
        "lint": "pnpm run lint:js && pnpm run lint:markdown",
        "lint:check": "pnpm run lint:js:check && pnpm run lint:markdown:check",
        "lint:js": "oxlint --fix waku.config.ts tooling tests",
        "lint:js:check": "oxlint waku.config.ts tooling tests",
        "lint:markdown": "markdownlint-cli2 --fix",
        "lint:markdown:check": "markdownlint-cli2",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "node --test tests/*.test.mjs",
        "deploy": "wrangler deploy --config wrangler.jsonc",
        "deploy:check": "wrangler deploy --config wrangler.jsonc --dry-run",
        "smoke": "node ../../scripts/docs-smoke.mjs"
    },
    "dependencies": {
        "@nickwelsh/docs-base": "1.0.1",
        "fumadocs-core": "16.17.7",
        "fumadocs-mdx": "15.4.8",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-server-dom-webpack": "19.3.1",
        "waku": "1.0.0-rc.3"
    },
    "devDependencies": {
        "@nickwelsh/refquill": "workspace:*",
        "@nickwelsh/refquill-fumadocs": "workspace:*",
        "@types/node": "^26.6.5",
        "markdownlint-cli2": "^0.23.2",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "typescript": "~6.0.3",
        "wrangler": "4.151.2",
        "yaml": "^2.9.1"
    }
}
