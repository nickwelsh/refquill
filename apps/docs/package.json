{
    "name": "@refquill/docs",
    "private": true,
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "dev": "pnpm api:generate && waku dev",
        "build": "pnpm api:generate && node ../../scripts/clean-docs-build.mjs && waku build && node ../../scripts/prepare-docs-worker.mjs",
        "api:generate": "pnpm --workspace-root docs:rustdoc && refquill generate ../../refquill.json",
        "api:validate": "refquill validate src/generated/api.json",
        "start": "wrangler dev --config wrangler.jsonc --local",
        "types:check": "tsc --noEmit",
        "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:markdown",
        "lint:check": "pnpm run lint:js:check && pnpm run lint:css:check && pnpm run lint:markdown:check",
        "lint:js": "oxlint --fix",
        "lint:js:check": "oxlint",
        "lint:css": "stylelint \"**/*.css\" --fix",
        "lint:css:check": "stylelint \"**/*.css\"",
        "lint:markdown": "markdownlint-cli2 --fix",
        "lint:markdown:check": "markdownlint-cli2",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "test": "node --test tests/*.test.ts",
        "deploy": "wrangler deploy --config wrangler.jsonc",
        "deploy:check": "wrangler deploy --config wrangler.jsonc --dry-run",
        "smoke": "node ../../scripts/docs-smoke.mjs"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jetbrains-mono": "^5.3.0",
        "@nickwelsh/refquill-fumadocs": "workspace:*",
        "@nickwelsh/refquill-schema": "workspace:*",
        "cn": "^0.4.0",
        "fumadocs-core": "16.17.2",
        "fumadocs-mdx": "15.4.7",
        "fumadocs-twoslash": "^4.0.2",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.2",
        "hast-util-to-jsx-runtime": "2.3.6",
        "next-themes": "^0.4.6",
        "react": "^19.3.0",
        "react-aria": "3.53.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.0",
        "react-markdown": "10.1.0",
        "react-server-dom-webpack": "^19.3.0",
        "remark-gfm": "4.0.1",
        "shiki": "^4.5.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss-react-aria-components": "^2.2.0",
        "takumi-js": "^2.14.0",
        "tw-animate-css": "^1.4.0",
        "waku": "1.0.0-rc.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@babel/parser": "^8.0.7",
        "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
        "@html-eslint/eslint-plugin-react": "^0.66.1",
        "@iconify-json/carbon": "^1.2.28",
        "@mdx-js/mdx": "^3.1.1",
        "@nickwelsh/refquill": "workspace:*",
        "@svgr/core": "^8.1.0",
        "@svgr/plugin-jsx": "^8.1.0",
        "@tailwindcss/vite": "^4.3.3",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@yutengjing/vscode-icons": "0.2.0",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-no-only-tests": "^3.4.0",
        "eslint-plugin-no-use-extend-native": "^0.7.3",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-regexp": "^3.1.0",
        "globals": "^17.11.0",
        "markdownlint-cli2": "^0.23.2",
        "oxc-transform-react": "^0.152.0",
        "oxfmt": "^0.73.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2004",
        "stylelint": "^17.14.1",
        "stylelint-config-standard": "^40.0.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.2",
        "wrangler": "4.151.0",
        "yaml": "^2.9.1"
    },
    "browserslist": [
        "last 2 Chrome versions",
        "last 2 Firefox versions",
        "last 2 Safari versions",
        "last 2 Edge versions"
    ]
}
