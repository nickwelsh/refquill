{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "htmlWhitespaceSensitivity": "css",
    "ignorePatterns": [".docs-base/**", "generated/**", "dist/**"],
    "overrides": [
        {
            "files": ["**/*.{yaml,yml}"],
            "options": {
                "tabWidth": 2
            }
        }
    ],
    "printWidth": 120,
    "semi": true,
    "singleAttributePerLine": false,
    "singleQuote": true,
    "sortPackageJson": true,
    "tabWidth": 4
}
