{
  "name": "refquill-frameworks-example",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "cargo run --locked --manifest-path ../../Cargo.toml -- generate refquill.json",
    "predev": "pnpm generate && pnpm --filter @nickwelsh/refquill-fumadocs build",
    "dev": "node --import tsx server.tsx",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@nickwelsh/refquill-fumadocs": "workspace:*",
    "fumadocs-core": "16.17.7",
    "fumadocs-ui": "16.17.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vue": "^3.5.0",
    "svelte": "^5.0.0",
    "solid-js": "^1.9.0"
  }
}
